{
  "name": "@fincore/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "knex migrate:latest --knexfile src/infrastructure/database/knexfile.ts",
    "db:rollback": "knex migrate:rollback --knexfile src/infrastructure/database/knexfile.ts",
    "db:seed": "tsx src/infrastructure/database/seed.ts",
    "db:migrate:make": "knex migrate:make --knexfile src/infrastructure/database/knexfile.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@fincore/contracts": "workspace:*",
    "express": "^4.21.1",
    "knex": "^3.1.0",
    "pg": "^8.13.1",
    "bcrypt": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^11.0.3",
    "zod": "^4.6.7",
    "helmet": "^8.0.0",
    "cors": "^2.8.5",
    "compression": "^1.7.5",
    "express-rate-limit": "^7.4.1",
    "bullmq": "^5.25.6",
    "ioredis": "^5.4.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "csv-stringify": "^6.5.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/uuid": "^10.0.0",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^8.57.1",
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "vitest": "^5.1.2",
    "vite": "^8.0.0",
    "@vitest/coverage-v8": "^5.1.2",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "rimraf": "^6.0.1"
  }
}
