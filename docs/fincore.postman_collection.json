{
  "info": {
    "name": "FinCore Simulated Wallet & Ledger API",
    "_postman_id": "a9e48e66-92fd-41f3-b85f-17fc4f9c2b10",
    "description": "Educational synthetic API collection covering all FinCore modules: Auth/MFA/Sessions, Customers, Wallets & Ledger, Beneficiaries, Transfers, Payment Intents & Signed Webhooks, Refunds/Reversals, Disputes, Statements, Reconciliation, FastAPI Risk Analytics, and Admin DLQ Recovery.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api/v1" },
    { "key": "riskBaseUrl", "value": "http://localhost:8000" },
    { "key": "accessToken", "value": "" },
    { "key": "stepUpToken", "value": "" },
    { "key": "walletId", "value": "" },
    { "key": "destWalletId", "value": "" },
    { "key": "beneficiaryId", "value": "" },
    { "key": "transferId", "value": "" },
    { "key": "paymentIntentId", "value": "" },
    { "key": "disputeId", "value": "" },
    { "key": "statementId", "value": "" },
    { "key": "riskServiceToken", "value": "replace_with_non_production_risk_token" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "01 Health & Contracts",
      "item": [
        {
          "name": "API Liveness",
          "request": { "method": "GET", "url": "{{baseUrl}}/health/live" }
        },
        {
          "name": "API Readiness",
          "request": { "method": "GET", "url": "{{baseUrl}}/health/ready" }
        },
        {
          "name": "Download OpenAPI YAML",
          "request": { "method": "GET", "url": "{{baseUrl}}/openapi.yaml" }
        },
        {
          "name": "Operational Metrics (Staff)",
          "request": { "method": "GET", "url": "{{baseUrl}}/metrics" }
        }
      ]
    },
    {
      "name": "02 Auth, Step-Up & Sessions",
      "item": [
        {
          "name": "Register Synthetic Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"learner.demo@fincore.test\",\n  \"password\": \"FinCore@2026!\",\n  \"fullName\": \"Learner Synthetic\",\n  \"countryCode\": \"IN\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login (Seeded Customer 1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', body.data.tokens.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer1@fincore.test\",\n  \"password\": \"FinCore@2026!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Step-Up (Password Reauth)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('stepUpToken', body.data.stepUpToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"FinCore@2026!\",\n  \"action\": \"TRANSFER_CREATE\"\n}"
            },
            "url": "{{baseUrl}}/auth/step-up"
          }
        },
        {
          "name": "Simulated MFA Challenge",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"action\": \"BENEFICIARY_MANAGE\"\n}" },
            "url": "{{baseUrl}}/auth/mfa/challenge"
          }
        },
        {
          "name": "Get Current User & Active Sessions",
          "request": { "method": "GET", "url": "{{baseUrl}}/auth/sessions" }
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/logout" }
        }
      ]
    },
    {
      "name": "03 Customers, Wallets & Ledger",
      "item": [
        {
          "name": "Get My Customer Profile",
          "request": { "method": "GET", "url": "{{baseUrl}}/customers/me" }
        },
        {
          "name": "List My Wallets",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.length > 0) pm.collectionVariables.set('walletId', body.data[0].id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/wallets" }
        },
        {
          "name": "Create Simulated Wallet",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"currency\": \"INR\"\n}" },
            "url": "{{baseUrl}}/wallets"
          }
        },
        {
          "name": "Get Wallet Balance",
          "request": { "method": "GET", "url": "{{baseUrl}}/wallets/{{walletId}}/balance" }
        },
        {
          "name": "Get Wallet Transactions",
          "request": { "method": "GET", "url": "{{baseUrl}}/wallets/{{walletId}}/transactions?page=1&pageSize=20" }
        },
        {
          "name": "Global Ledger Invariant Check (Staff)",
          "request": { "method": "GET", "url": "{{baseUrl}}/ledger/invariant-check" }
        },
        {
          "name": "Reconcile Wallet Balance Parity (Staff)",
          "request": { "method": "GET", "url": "{{baseUrl}}/ledger/reconcile/{{walletId}}" }
        }
      ]
    },
    {
      "name": "04 Beneficiaries & Transfers",
      "item": [
        {
          "name": "Save Beneficiary",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Step-Up-Token", "value": "{{stepUpToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nickname\": \"Synthetic Recipient\",\n  \"destinationWalletId\": \"{{destWalletId}}\"\n}"
            },
            "url": "{{baseUrl}}/beneficiaries"
          }
        },
        {
          "name": "Create Atomic Transfer (Idempotent)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.id) pm.collectionVariables.set('transferId', body.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "postman-{{$guid}}" },
              { "key": "X-Step-Up-Token", "value": "{{stepUpToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceWalletId\": \"{{walletId}}\",\n  \"destinationWalletId\": \"{{destWalletId}}\",\n  \"amountMinor\": 25000,\n  \"currency\": \"INR\",\n  \"description\": \"Postman synthetic transfer\",\n  \"requireConfirmation\": false\n}"
            },
            "url": "{{baseUrl}}/transfers"
          }
        },
        {
          "name": "List Transfers",
          "request": { "method": "GET", "url": "{{baseUrl}}/transfers?page=1&pageSize=20&sortBy=created_at&sortDir=desc" }
        },
        {
          "name": "Confirm Held Transfer",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Step-Up-Token", "value": "{{stepUpToken}}" }],
            "url": "{{baseUrl}}/transfers/{{transferId}}/confirm"
          }
        },
        {
          "name": "Cancel Held Transfer",
          "request": { "method": "POST", "url": "{{baseUrl}}/transfers/{{transferId}}/cancel" }
        }
      ]
    },
    {
      "name": "05 Payments, Webhooks, Refunds & Reversals",
      "item": [
        {
          "name": "Create Top-Up Payment Intent",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.id) pm.collectionVariables.set('paymentIntentId', body.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "intent-{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"walletId\": \"{{walletId}}\",\n  \"amountMinor\": 50000,\n  \"currency\": \"INR\"\n}"
            },
            "url": "{{baseUrl}}/payment-intents"
          }
        },
        {
          "name": "Simulate Signed Sandbox Webhook",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"eventType\": \"payment.captured\"\n}" },
            "url": "{{baseUrl}}/payment-intents/{{paymentIntentId}}/simulate-webhook"
          }
        },
        {
          "name": "Issue Refund",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "refund-{{$guid}}" },
              { "key": "X-Step-Up-Token", "value": "{{stepUpToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transferId\": \"{{transferId}}\",\n  \"amountMinor\": 10000,\n  \"reason\": \"Customer return synthetic refund\"\n}"
            },
            "url": "{{baseUrl}}/refunds"
          }
        },
        {
          "name": "Execute Reversal (Finance/Platform Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "rev-{{$guid}}" },
              { "key": "X-Step-Up-Token", "value": "{{stepUpToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transferId\": \"{{transferId}}\",\n  \"reason\": \"Staff compensating reversal\"\n}"
            },
            "url": "{{baseUrl}}/reversals"
          }
        }
      ]
    },
    {
      "name": "06 Disputes & Statements",
      "item": [
        {
          "name": "Raise Dispute",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transferId\": \"{{transferId}}\",\n  \"category\": \"UNRECOGNIZED_TRANSFER\",\n  \"description\": \"Synthetic dispute test case\"\n}"
            },
            "url": "{{baseUrl}}/disputes"
          }
        },
        {
          "name": "Generate Statement Snapshot",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"walletId\": \"{{walletId}}\",\n  \"periodStart\": \"2026-01-01T00:00:00.000Z\",\n  \"periodEnd\": \"2026-12-31T23:59:59.000Z\"\n}"
            },
            "url": "{{baseUrl}}/statements"
          }
        },
        {
          "name": "Export Statement CSV",
          "request": { "method": "GET", "url": "{{baseUrl}}/statements/{{statementId}}/export" }
        }
      ]
    },
    {
      "name": "07 Operations, Risk, Reconciliation & Admin",
      "item": [
        {
          "name": "Operations Dashboard",
          "request": { "method": "GET", "url": "{{baseUrl}}/operations/dashboard" }
        },
        {
          "name": "List Reconciliation Exceptions",
          "request": { "method": "GET", "url": "{{baseUrl}}/reconciliation/exceptions" }
        },
        {
          "name": "List Risk Alerts",
          "request": { "method": "GET", "url": "{{baseUrl}}/risk/alerts" }
        },
        {
          "name": "FastAPI Direct Risk Assess (Internal Boundary)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Service-Token", "value": "{{riskServiceToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transaction_ref\": \"tx_demo_001\",\n  \"wallet_ref\": \"wlt_demo_001\",\n  \"amount_decimal\": \"12000.00\",\n  \"currency\": \"INR\",\n  \"beneficiary_age_minutes\": 5,\n  \"tx_count_24h\": 6,\n  \"volume_24h_decimal\": \"18000.00\",\n  \"failed_count_24h\": 1,\n  \"historical_avg_decimal\": \"1500.00\",\n  \"beneficiaries_added_24h\": 2\n}"
            },
            "url": "{{riskBaseUrl}}/api/v1/assess"
          }
        },
        {
          "name": "List Audit Events",
          "request": { "method": "GET", "url": "{{baseUrl}}/admin/audit-events?page=1&pageSize=20" }
        },
        {
          "name": "List Failed Outbox Events (DLQ)",
          "request": { "method": "GET", "url": "{{baseUrl}}/admin/outbox/failed" }
        }
      ]
    }
  ]
}
