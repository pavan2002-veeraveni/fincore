{
  "name": "fincore",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:api": "pnpm --filter @fincore/api run test",
    "test:web": "pnpm --filter @fincore/web run test",
    "test:risk": "cd services/risk && python -m pytest",
    "db:migrate": "pnpm --filter @fincore/api run db:migrate",
    "db:seed": "pnpm --filter @fincore/api run db:seed",
    "db:rollback": "pnpm --filter @fincore/api run db:rollback",
    "clean": "pnpm -r run clean"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.33",
      "vite": "^8.0.0"
    }
  }
}
