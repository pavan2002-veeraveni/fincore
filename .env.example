
# ──────────────────────────────────────────────
# FinCore Environment Variables (.env.example)
# Copy to .env and fill in real values.
# NEVER commit .env — only .env.example.
# ──────────────────────────────────────────────

# ── General ──
NODE_ENV=development
PORT=4000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000

# ── Database ──
DATABASE_URL=postgresql://fincore:fincore_dev@localhost:5432/fincore_dev

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── Authentication ──
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=CHANGE_ME_access_token_secret_64_chars
REFRESH_TOKEN_SECRET=CHANGE_ME_refresh_token_secret_64_chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ── Risk Service ──
RISK_SERVICE_URL=http://localhost:8000
RISK_SERVICE_TOKEN=CHANGE_ME_internal_service_token

# ── Payment Provider Sandbox ──
SANDBOX_PROVIDER_KEY=sandbox_key_not_real
SANDBOX_PROVIDER_SECRET=sandbox_secret_not_real
SANDBOX_WEBHOOK_SECRET=sandbox_webhook_secret_not_real

# ── Notifications (Sandbox) ──
EMAIL_SANDBOX_ENABLED=true
SMS_SANDBOX_ENABLED=true

# ── Logging ──
LOG_LEVEL=info
LOG_FORMAT=json
